<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Jexel.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Jexel.App.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Jexel.App.ViewModels"
    mc:Ignorable="d"
    Title="Jexel — JPEG XL 转换器">

    <Grid
        x:Name="RootGrid"
        AllowDrop="True"
        DragLeave="OnRootDragLeave"
        DragOver="OnRootDragOver"
        Drop="OnRootDrop">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  ═══════════════════════ 自定义标题栏 ═══════════════════════  -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="48"
            VerticalAlignment="Top">
            <StackPanel
                Margin="20,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">
                <Border
                    Width="22"
                    Height="22"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="6">
                    <FontIcon
                        FontSize="12"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        Glyph="&#xEB9F;" />
                </Border>
                <TextBlock
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="Jexel" />
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="JPEG XL 转换器" />
            </StackPanel>
        </Grid>

        <!--  ═══════════════════════ 主内容 ═══════════════════════  -->
        <Grid
            Grid.Row="1"
            Margin="20,0,20,12"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="356" />
            </Grid.ColumnDefinitions>

            <!--  ─────────── 左侧：文件清单与对比视图 ───────────  -->
            <Grid Grid.Column="0" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  工具栏  -->
                <StackPanel
                    Grid.Row="0"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        AutomationProperties.Name="添加文件"
                        Click="OnAddFilesClick"
                        ToolTipService.ToolTip="选择一个或多个图像文件">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE8E5;" />
                            <TextBlock Text="添加文件" />
                        </StackPanel>
                    </Button>
                    <Button
                        AutomationProperties.Name="添加文件夹"
                        Click="OnAddFolderClick"
                        ToolTipService.ToolTip="导入整个文件夹中的图像">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE8B7;" />
                            <TextBlock Text="添加文件夹" />
                        </StackPanel>
                    </Button>
                    <Button
                        AutomationProperties.Name="清空清单"
                        Command="{x:Bind ViewModel.ClearAllCommand}"
                        ToolTipService.ToolTip="清空清单">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE74D;" />
                            <TextBlock Text="清空" />
                        </StackPanel>
                    </Button>
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.FileCountText, Mode=OneWay}" />
                </StackPanel>

                <!--  清单卡片  -->
                <Border
                    Grid.Row="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  列标题  -->
                        <Border
                            Grid.Row="0"
                            Padding="16,10"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="输入文件" />
                                <TextBlock
                                    Grid.Column="2"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="输出文件（JPEG XL）" />
                            </Grid>
                        </Border>

                        <!--  文件列表  -->
                        <ListView
                            x:Name="FileList"
                            Grid.Row="1"
                            Background="Transparent"
                            IsItemClickEnabled="False"
                            ItemsSource="{x:Bind ViewModel.Items}"
                            SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ConversionItemViewModel">
                                    <Border
                                        Padding="16,10"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,0,1">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="36" />
                                            </Grid.ColumnDefinitions>

                                            <!--  输入侧  -->
                                            <Grid Grid.Column="0" ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon
                                                    Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    FontSize="16"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Glyph="&#xEB9F;" />
                                                <StackPanel
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center">
                                                    <TextBlock
                                                        FontSize="13"
                                                        Text="{x:Bind SourceFileName}"
                                                        TextTrimming="CharacterEllipsis"
                                                        ToolTipService.ToolTip="{x:Bind SourcePath}" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                        Text="{x:Bind SourceDetails}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="打开源文件"
                                                    Click="OnOpenSourceClick"
                                                    Style="{StaticResource IconButtonStyle}"
                                                    Tag="{x:Bind}"
                                                    ToolTipService.ToolTip="用默认程序打开源文件">
                                                    <FontIcon FontSize="14" Glyph="&#xE8E5;" />
                                                </Button>
                                            </Grid>

                                            <!--  箭头  -->
                                            <FontIcon
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Glyph="&#xE72A;" />

                                            <!--  输出侧  -->
                                            <Grid Grid.Column="2" ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon
                                                    Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    FontSize="16"
                                                    Foreground="{x:Bind helpers:XamlHelpers.StateBrush(State), Mode=OneWay}"
                                                    Glyph="{x:Bind helpers:XamlHelpers.StateGlyph(State), Mode=OneWay}" />
                                                <StackPanel
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center">
                                                    <TextBlock
                                                        FontSize="13"
                                                        Text="{x:Bind DestinationFileName, Mode=OneWay}"
                                                        TextTrimming="CharacterEllipsis"
                                                        ToolTipService.ToolTip="{x:Bind DestinationPath, Mode=OneWay}" />
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock
                                                            FontSize="11"
                                                            Foreground="{x:Bind helpers:XamlHelpers.StateBrush(State), Mode=OneWay}"
                                                            Text="{x:Bind StatusText, Mode=OneWay}" />
                                                        <TextBlock
                                                            FontSize="11"
                                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                            Text="{x:Bind DestinationSizeText, Mode=OneWay}"
                                                            Visibility="{x:Bind helpers:XamlHelpers.Visible(IsSucceeded), Mode=OneWay}" />
                                                        <TextBlock
                                                            FontSize="11"
                                                            FontWeight="SemiBold"
                                                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                            Text="{x:Bind ReductionText, Mode=OneWay}"
                                                            Visibility="{x:Bind helpers:XamlHelpers.Visible(IsSucceeded), Mode=OneWay}" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                        Text="{x:Bind ErrorMessage, Mode=OneWay}"
                                                        TextTrimming="CharacterEllipsis"
                                                        Visibility="{x:Bind helpers:XamlHelpers.Visible(IsFailed), Mode=OneWay}" />
                                                </StackPanel>
                                                <Button
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="打开输出文件"
                                                    Click="OnOpenDestinationClick"
                                                    IsEnabled="{x:Bind CanOpenDestination, Mode=OneWay}"
                                                    Style="{StaticResource IconButtonStyle}"
                                                    Tag="{x:Bind}"
                                                    ToolTipService.ToolTip="用默认程序打开转换后的文件">
                                                    <FontIcon FontSize="14" Glyph="&#xE8A7;" />
                                                </Button>
                                            </Grid>

                                            <!--  移除  -->
                                            <Button
                                                Grid.Column="3"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="从清单中移除"
                                                Click="OnRemoveItemClick"
                                                Style="{StaticResource IconButtonStyle}"
                                                Tag="{x:Bind}"
                                                ToolTipService.ToolTip="从清单中移除">
                                                <FontIcon FontSize="12" Glyph="&#xE711;" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!--  空状态  -->
                        <StackPanel
                            Grid.Row="1"
                            MaxWidth="360"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="10"
                            Visibility="{x:Bind helpers:XamlHelpers.Visible(ViewModel.IsEmpty), Mode=OneWay}">
                            <FontIcon
                                FontSize="40"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Glyph="&#xE91B;" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{ThemeResource SubtitleTextBlockStyle}"
                                Text="把图像拖到这里" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="支持 PNG、JPEG、WebP、AVIF、TIFF、GIF、PSD 等常见格式，可一次拖入多个文件或整个文件夹。"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!--  ─────────── 右侧：设置与操作 ───────────  -->
            <Grid Grid.Column="1" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer
                    Grid.Row="0"
                    IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                    Padding="0,0,4,0"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">

                        <!--  压缩模式  -->
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                            <StackPanel>
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="压缩模式" />
                                <RadioButton
                                    Margin="0,10,0,0"
                                    Content="无损"
                                    GroupName="CompressionMode"
                                    IsChecked="{x:Bind ViewModel.IsLosslessMode, Mode=TwoWay}" />
                                <TextBlock
                                    Margin="28,2,0,0"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="解码结果与源图像逐像素完全一致。"
                                    TextWrapping="Wrap" />
                                <RadioButton
                                    Margin="0,10,0,0"
                                    Content="有损"
                                    GroupName="CompressionMode"
                                    IsChecked="{x:Bind ViewModel.IsLossyMode, Mode=TwoWay}" />
                                <TextBlock
                                    Margin="28,2,0,0"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="按质量目标压缩，体积通常显著更小。"
                                    TextWrapping="Wrap" />

                                <!--  质量  -->
                                <Grid Margin="0,14,0,0">
                                    <TextBlock Text="质量" />
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ViewModel.QualityText, Mode=OneWay}" />
                                </Grid>
                                <Slider
                                    Maximum="99"
                                    Minimum="1"
                                    StepFrequency="1"
                                    IsEnabled="{x:Bind ViewModel.IsLossySelected, Mode=OneWay}"
                                    Value="{x:Bind ViewModel.Quality, Mode=TwoWay}" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="仅在有损模式下生效，数值越高画质越好。"
                                    TextWrapping="Wrap" />

                                <!--  编码强度  -->
                                <Grid Margin="0,14,0,0">
                                    <TextBlock Text="编码强度" />
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ViewModel.EffortText, Mode=OneWay}" />
                                </Grid>
                                <Slider
                                    Maximum="9"
                                    Minimum="1"
                                    StepFrequency="1"
                                    Value="{x:Bind ViewModel.Effort, Mode=TwoWay}" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="数值越高压缩得越小，但耗时更长。推荐 7。"
                                    TextWrapping="Wrap" />

                                <!--  色彩配置文件  -->
                                <CheckBox
                                    Margin="0,14,0,0"
                                    MinWidth="0"
                                    AutomationProperties.Name="保留色彩配置文件"
                                    Content="保留内嵌色彩配置文件（ICC）"
                                    IsChecked="{x:Bind ViewModel.PreserveIccProfile, Mode=TwoWay}" />
                                <TextBlock
                                    Margin="28,2,0,0"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="关闭可减小体积，但非 sRGB 图像（如 Adobe RGB、印刷 CMYK）的颜色会变得不准确。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!--  输出位置  -->
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                            <StackPanel>
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="输出位置" />
                                <RadioButton
                                    Margin="0,10,0,0"
                                    Content="指定输出文件夹"
                                    GroupName="OutputLocation"
                                    IsChecked="{x:Bind ViewModel.IsCustomFolderMode, Mode=TwoWay}" />
                                <Button
                                    Margin="28,6,0,0"
                                    AutomationProperties.Name="选择输出文件夹"
                                    Click="OnPickOutputFolderClick"
                                    IsEnabled="{x:Bind ViewModel.IsCustomFolderSelected, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE8B7;" />
                                        <TextBlock Text="选择文件夹…" />
                                    </StackPanel>
                                </Button>
                                <TextBlock
                                    Margin="28,6,0,0"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="{x:Bind ViewModel.OutputFolderDisplay, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.OutputFolderDisplay, Mode=OneWay}" />

                                <RadioButton
                                    Margin="0,12,0,0"
                                    Content="原地输出"
                                    GroupName="OutputLocation"
                                    IsChecked="{x:Bind ViewModel.IsAlongsideMode, Mode=TwoWay}" />
                                <TextBlock
                                    Margin="28,2,0,0"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="输出文件与源文件放在同一目录。扩展名不同，不会与源文件重名，源文件也不会被改动。"
                                    TextWrapping="Wrap" />

                                <!--  同名文件策略  -->
                                <TextBlock
                                    Margin="0,14,0,6"
                                    Text="目标文件已存在时" />
                                <ComboBox
                                    HorizontalAlignment="Stretch"
                                    SelectedIndex="{x:Bind ViewModel.ConflictPolicyIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="自动重命名（推荐）" />
                                    <ComboBoxItem Content="跳过该文件" />
                                    <ComboBoxItem Content="覆盖已有文件" />
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!--  说明  -->
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        FontSize="13"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xE946;" />
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="源文件安全" />
                                </StackPanel>
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="转换过程只会读取源文件，写入时先落到临时文件再原子改名。任何中断都不会破坏原始图像，也不会留下不完整的输出。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!--  主操作  -->
                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="StartConversionButton"
                        Grid.Column="0"
                        MinWidth="150"
                        AutomationProperties.Name="开始转换"
                        Command="{x:Bind ViewModel.StartConversionCommand}"
                        Style="{ThemeResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE768;" />
                            <TextBlock Text="开始转换" />
                        </StackPanel>
                    </Button>
                    <Button
                        Grid.Column="1"
                        AutomationProperties.Name="取消转换"
                        Command="{x:Bind ViewModel.CancelConversionCommand}"
                        Visibility="{x:Bind helpers:XamlHelpers.Visible(ViewModel.IsBusy), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE711;" />
                            <TextBlock Text="取消" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Grid>

        <!--  ═══════════════════════ 状态栏 ═══════════════════════  -->
        <Grid
            Grid.Row="2"
            Padding="20,0,20,14"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Spacing="6">
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                <ProgressBar
                    Maximum="100"
                    Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}"
                    Visibility="{x:Bind helpers:XamlHelpers.Visible(ViewModel.IsBusy), Mode=OneWay}" />
            </StackPanel>

            <!--  体积对比汇总  -->
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="12"
                Visibility="{x:Bind helpers:XamlHelpers.Visible(ViewModel.HasAnyFile), Mode=OneWay}">
                <StackPanel>
                    <TextBlock
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="输入总计" />
                    <TextBlock
                        FontSize="13"
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.TotalSourceText, Mode=OneWay}" />
                </StackPanel>
                <FontIcon
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xE72A;" />
                <StackPanel>
                    <TextBlock
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="输出总计" />
                    <TextBlock
                        FontSize="13"
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.TotalDestinationText, Mode=OneWay}" />
                </StackPanel>
                <Border
                    Padding="8,4"
                    Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                    CornerRadius="4"
                    Visibility="{x:Bind helpers:XamlHelpers.VisibleIfNotEmpty(ViewModel.TotalReductionText), Mode=OneWay}">
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                        Text="{x:Bind ViewModel.TotalReductionText, Mode=OneWay}" />
                </Border>
            </StackPanel>
        </Grid>

        <!--  ═══════════════════════ 拖拽提示层 ═══════════════════════  -->
        <Grid
            Grid.RowSpan="3"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            IsHitTestVisible="False"
            Opacity="0.94"
            Visibility="{x:Bind helpers:XamlHelpers.Visible(ViewModel.IsDragActive), Mode=OneWay}">
            <Border
                Margin="24"
                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                BorderThickness="2"
                CornerRadius="12">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="14">
                    <FontIcon
                        FontSize="44"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Glyph="&#xE896;" />
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="松开即可添加图像" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="支持文件与文件夹" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
