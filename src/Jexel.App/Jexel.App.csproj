<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Jexel.App</RootNamespace>
    <AssemblyName>Jexel</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Jexel.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <!--
      WinUI 3 需要在具体平台上构建。这里同时保留 AnyCPU 是为了让
      `dotnet build Jexel.slnx` 与 `dotnet build src/Jexel.App/Jexel.App.csproj`
      产出一致的输出目录（bin\<Configuration>\...），避免出现两份可执行文件。
    -->
    <Platforms>AnyCPU;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <DefaultLanguage>zh-CN</DefaultLanguage>
    <!--
      支持语言只有中文与英文。
      SatelliteResourceLanguages 控制 NuGet 包带入的卫星资源程序集，
      发布产物的 WinUI .mui 目录由下面的 TrimUnusedLanguageResources 目标裁剪。
    -->
    <SatelliteResourceLanguages>zh-Hans;zh-Hant;en</SatelliteResourceLanguages>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>0.1.0</Version>
    <Product>Jexel</Product>
    <AssemblyTitle>Jexel — JPEG XL 转换器</AssemblyTitle>
    <Company>Jexel</Company>
    <Copyright>Copyright © 2026</Copyright>
  </PropertyGroup>

  <!-- 裁剪与单文件会破坏 WinUI 3 的 XAML 资源加载，必须保持关闭。 -->
  <PropertyGroup>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <!--
      MVVMTK0045 提示 [ObservableProperty] 字段在启用 AOT 的 WinRT 场景下不兼容。
      本项目明确不启用 AOT 与裁剪（WinUI 3 本身也不支持），因此该建议不适用。
    -->
    <NoWarn>$(NoWarn);MVVMTK0045</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.250907003" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jexel.Core\Jexel.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    发布时只保留中文与英文的 WinUI 本地化资源。
    Windows App SDK 自包含发布会带入 90 个语言的 .mui 与同名目录，对本工具没有意义，
    删除后分发包体积明显减小。语言目录名形如 de-DE、sr-Cyrl-BA，
    因此用 BCP-47 形状的正则匹配，避免误删 Assets、NpuDetect、Microsoft.UI.Xaml 等目录。
  -->
  <Target Name="TrimUnusedLanguageResources" AfterTargets="Publish">
    <ItemGroup>
      <_JexelPublishedFile Include="$(PublishDir)**\*" />
      <_JexelUnusedLanguageFile
          Include="@(_JexelPublishedFile)"
          Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(_JexelPublishedFile.RecursiveDir)', '^(?!zh-CN[\\/]|zh-TW[\\/]|en-us[\\/]|en-GB[\\/])[A-Za-z]{2,3}(-[A-Za-z0-9]+)+[\\/]'))" />
      <_JexelUnusedLanguageDir Include="@(_JexelUnusedLanguageFile->'%(RootDir)%(Directory)')" />
    </ItemGroup>

    <Message Importance="high" Text="Jexel: 移除 @(_JexelUnusedLanguageFile->Count()) 个非中英文语言资源文件" />
    <Delete Files="@(_JexelUnusedLanguageFile)" />
    <RemoveDir Directories="@(_JexelUnusedLanguageDir)" />
  </Target>

</Project>
